# Runtime-only read access to the Sora Silver bucket.
# Use a dedicated RustFS credential with read permission only.
APP_CONFIG__S3__SILVER__ENDPOINT_URL=
APP_CONFIG__S3__SILVER__BUCKET=
APP_CONFIG__S3__SILVER__REGION_NAME=us-east-1
APP_CONFIG__S3__SILVER__ACCESS_KEY_ID=
APP_CONFIG__S3__SILVER__SECRET_ACCESS_KEY=
APP_CONFIG__S3__SILVER__ADDRESSING_STYLE=path
APP_CONFIG__S3__SILVER__VERIFY_SSL=true

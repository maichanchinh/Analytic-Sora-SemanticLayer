# Silver RustFS read-only settings for API and MCP. Replace placeholders locally
# or enter the real values in Dockhand's Compose environment; never commit them.
APP_CONFIG__S3__SILVER__ENDPOINT_URL=https://rustfs.example.invalid:3900
APP_CONFIG__S3__SILVER__BUCKET=sora-silver-bucket
APP_CONFIG__S3__SILVER__REGION_NAME=us-east-1
APP_CONFIG__S3__SILVER__ACCESS_KEY_ID=replace-with-read-only-access-key
APP_CONFIG__S3__SILVER__SECRET_ACCESS_KEY=replace-with-read-only-secret-key
APP_CONFIG__S3__SILVER__ADDRESSING_STYLE=path
APP_CONFIG__S3__SILVER__VERIFY_SSL=true

# Dashboard runs in the user's browser, so use an API URL reachable by that
# browser. This value is embedded into the Dashboard image during its build.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
DASHBOARD_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Host ports; container ports remain fixed at 8000, 8001 and 3000.
API_HOST_PORT=8000
MCP_HOST_PORT=8001
DASHBOARD_HOST_PORT=3000

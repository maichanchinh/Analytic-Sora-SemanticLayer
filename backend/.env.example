# Backend Silver read-only settings. Replace placeholders in backend/.env.local.
APP_CONFIG__S3__SILVER__ENDPOINT_URL='https://rustfs.example.invalid:3900'
APP_CONFIG__S3__SILVER__REGION_NAME='us-east-1'
APP_CONFIG__S3__SILVER__ACCESS_KEY_ID='replace-with-read-only-access-key'
APP_CONFIG__S3__SILVER__SECRET_ACCESS_KEY='replace-with-read-only-secret-key'
APP_CONFIG__S3__SILVER__ADDRESSING_STYLE='path'
APP_CONFIG__S3__SILVER__VERIFY_SSL='true'
APP_CONFIG__S3__SILVER__BUCKET='sora-silver-bucket'
APP_CONFIG__S3__SILVER__CREDENTIALS_BLOCK_NAME='sora-silver-credentials'
APP_CONFIG__S3__SILVER__BUCKET_BLOCK_NAME='sora-silver-bucket'
